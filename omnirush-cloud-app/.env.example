# Set a long random password before exposing the app on a forwarded/public port.
APP_PASSWORD=replace-this-with-a-long-random-password
SESSION_SECRET=replace-this-with-a-different-long-random-secret
PORT=3000
DATA_DIR=.data
WORKSPACES_DIR=workspaces
# On Railway, set HOME=/data/home, DATA_DIR=/data/app, WORKSPACES_DIR=/data/workspaces
# Optional: set to 1 only behind HTTPS. Codespaces forwarded URLs are HTTPS at the browser.
COOKIE_SECURE=0
